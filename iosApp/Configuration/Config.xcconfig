TEAM_ID=

PRODUCT_NAME=IO Switch
PRODUCT_BUNDLE_IDENTIFIER=io.iprashantpanwar.ioswitch.IOSwitch$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../composeApp/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)" "$(SRCROOT)/../composeApp/build/bin/iosSimulatorArm64/$(CONFIGURATION)Framework" "$(SRCROOT)/../composeApp/build/bin/iosArm64/$(CONFIGURATION)Framework"
OTHER_LDFLAGS = $(inherited) -framework ComposeApp
